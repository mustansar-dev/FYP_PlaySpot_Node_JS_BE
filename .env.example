NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_ORIGINS=http://localhost:8081

# Optional first-install provisioning. Give this local-only .env value to an
# administrator account that can create roles/databases and install extensions.
PLAYSPOT_POSTGRES_ADMIN_URL=
PLAYSPOT_DB_NAME=playspot_db
PLAYSPOT_SHADOW_DB_NAME=playspot_shadow
# Setup generates strong local role passwords when admin provisioning is enabled.
PLAYSPOT_USER_PASSWORD=
PLAYSPOT_MIGRATOR_PASSWORD=

# Runtime connection uses the restricted application role (normally playspot_user).
DATABASE_URL=
# Prisma migrations and idempotent reference-data seed use the DDL role
# (normally playspot_migrator). Keep it on the same PostgreSQL database.
MIGRATOR_DATABASE_URL=
# Optional, required only for `npm run prisma:migrate:dev` when the migrator
# role cannot create a temporary shadow database. Never use the production DB.
SHADOW_DATABASE_URL=

# `npm run setup` generates independent local values when either is blank.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=venue-media
# Server-side Geoapify tiles and Pakistan place search. Keep this key in the
# backend .env only; the API proxies map requests so it is not bundled in Android.
GEOAPIFY_API_KEY=
SAFEPAY_ENV=sandbox
# Use the explicit local simulation until Safepay Sandbox credentials are issued.
# Set to safepay only after the sandbox account, keys and webhook are configured.
PAYMENT_PROVIDER=development_mock
SAFEPAY_SECRET_KEY=
SAFEPAY_API_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_RETURN_URL=
SAFEPAY_CANCEL_URL=
PAYMENT_RECEIPTS_BUCKET=payment-receipts
# Development only; receipt files are private and ignored by Git.
PAYMENT_RECEIPTS_LOCAL_DIR=./.data/payment-receipts
