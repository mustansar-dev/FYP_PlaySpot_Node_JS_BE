NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_ORIGINS=http://localhost:8081

# Required before starting the API. Use an isolated local database or the
# team-approved Supabase development database; never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Generate independent random secrets of at least 32 characters for each value.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=venue-media
GEOAPIFY_API_KEY=
SAFEPAY_ENV=sandbox
# Use the explicit local simulation until Safepay Sandbox credentials are issued.
# Set to safepay only after the sandbox account, keys and webhook are configured.
PAYMENT_PROVIDER=development_mock
SAFEPAY_SECRET_KEY=
SAFEPAY_API_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_RETURN_URL=
SAFEPAY_CANCEL_URL=
PAYMENT_RECEIPTS_BUCKET=payment-receipts
