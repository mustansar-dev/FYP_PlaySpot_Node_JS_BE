{
  "name": "playspot-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PlaySpot PK API foundation",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sfpy/node-sdk": "^3.0.2",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "multer": "^2.5.0",
    "pg": "8.23.1",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "22.20.4",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.5",
    "prisma": "7.10.1",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.2",
    "tsx": "4.20.6",
    "typescript": "5.8.3",
    "typescript-eslint": "8.36.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@sfpy/node-sdk": {
      "axios": "^1.21.1"
    }
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "db:setup": "node scripts/setup.mjs --skip-install",
    "db:provision": "node scripts/provision-local-db.mjs",
    "db:check": "node scripts/check-db.mjs",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:seed": "prisma db seed",
    "seed:demo-marketplace": "node --import tsx scripts/seed-demo-marketplace.mjs"
  }
}
